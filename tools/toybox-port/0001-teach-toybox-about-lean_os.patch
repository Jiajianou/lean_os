# tools/toybox-port/0001-teach-toybox-about-lean_os.patch - M89
#
# Toybox's portability layer supports a closed set of operating systems
# and stops with #error on any other. This is lean_os's case: the three
# device-number encodings, one filesystem-type name, and the header that
# carries struct statfs. Nothing here changes what toybox does on any
# system it already knew about.
#
# Applied to build/toybox by tools/build-toybox.sh. third_party/toybox
# stays byte-identical to the published tarball - see that script's
# header for the argument.
--- third_party/toybox/lib/portability.h	2025-01-18 13:20:33
+++ build/toybox/lib/portability.h	2026-09-01 22:24:41
@@ -164,6 +164,11 @@
 
 // Linux headers not listed by POSIX or LSB
 #include <sys/mount.h>
+#ifdef __lean_os__
+// lean_os provides statfs over the same syscall as statvfs; it has no
+// swap and no sysinfo(), so those two headers are not included here.
+#include <sys/statfs.h>
+#endif
 #ifdef __linux__
 #include <sys/statfs.h>
 #include <sys/swap.h>
--- third_party/toybox/lib/portability.c	2025-01-18 13:20:33
+++ build/toybox/lib/portability.c	2026-09-01 22:24:41
@@ -511,7 +511,13 @@
 
 int dev_minor(int dev)
 {
-#if defined(__linux__)
+#if defined(__lean_os__)
+  // lean_os has no device numbers: every st_dev is 0 and there is one
+  // filesystem (see its <sys/stat.h>). Linux's encoding is used so that
+  // a number round-trips through dev_makedev, which is all these are
+  // for here.
+  return ((dev&0xfff00000)>>12)|(dev&0xff);
+#elif defined(__linux__)
   return ((dev&0xfff00000)>>12)|(dev&0xff);
 #elif defined(__APPLE__)
   return dev&0xffffff;
@@ -524,8 +530,14 @@
 
 int dev_major(int dev)
 {
-#if defined(__linux__)
+#if defined(__lean_os__)
+  // lean_os has no device numbers: every st_dev is 0 and there is one
+  // filesystem (see its <sys/stat.h>). Linux's encoding is used so that
+  // a number round-trips through dev_makedev, which is all these are
+  // for here.
   return (dev&0xfff00)>>8;
+#elif defined(__linux__)
+  return (dev&0xfff00)>>8;
 #elif defined(__APPLE__)
   return (dev>>24)&0xff;
 #elif defined(__FreeBSD__) || defined(__OpenBSD__)
@@ -537,7 +549,7 @@
 
 int dev_makedev(int major, int minor)
 {
-#if defined(__linux__)
+#if defined(__lean_os__) || defined(__linux__)
   return (minor&0xff)|((major&0xfff)<<8)|((minor&0xfff00)<<12);
 #elif defined(__APPLE__)
   return (minor&0xffffff)|((major&0xff)<<24);
@@ -550,7 +562,11 @@
 
 char *fs_type_name(struct statfs *statfs)
 {
-#if defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__)
+#if defined(__lean_os__)
+  // One filesystem, and its magic is its own rather than borrowed from a
+  // Linux one - see lean_os's <sys/statfs.h>.
+  return statfs->f_type == LEANFS_SUPER_MAGIC ? "leanfs" : "unknown";
+#elif defined(__APPLE__) || defined(__FreeBSD__) || defined(__OpenBSD__)
   // macOS has an `f_type` field, but assigns values dynamically as filesystems
   // are registered. They do give you the name directly though, so use that.
   return statfs->f_fstypename;

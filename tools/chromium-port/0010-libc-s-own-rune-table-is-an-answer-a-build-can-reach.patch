+  #
+  # libc++ carries a table for each C library it knows, and stops with
+  # "unknown rune table for this platform" for one it does not - which is
+  # every out-of-tree platform whose libc is neither glibc, musl, BSD's nor
+  # Apple's. Its own table is the answer libc++ itself offers for that case;
+  # the define is libc++'s, and this only makes it reachable from a build
+  # that is not editing __config_site by hand.
+  libcxx_provides_default_rune_table = false

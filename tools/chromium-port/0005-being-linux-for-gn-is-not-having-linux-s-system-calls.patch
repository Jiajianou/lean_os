 namespace partition_alloc::internal::base {
 
+namespace {
+
+// pthread_t is an integer on some POSIX platforms and a pointer on others, so
+// the conversion that reaches a PlatformThreadId is not the same cast in both
+// cases: reinterpret_cast does not accept an integer that is not pointer-sized.
+template <typename T>
+  requires(std::is_integral_v<T>)
+PlatformThreadId ThreadIdFromPthread(T thread) {
+  return static_cast<PlatformThreadId>(thread);
+}
+
+template <typename T>
+PlatformThreadId ThreadIdFromPthread(T* thread) {
+  return static_cast<PlatformThreadId>(reinterpret_cast<uintptr_t>(thread));
+}
+
+}  // namespace
+
 // static

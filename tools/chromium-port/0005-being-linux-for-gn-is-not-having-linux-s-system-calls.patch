+declare_args() {
+  # Whether this platform offers the Linux kernel's own interfaces - futex(2)
+  # and prctl(2) - rather than only POSIX.
+  #
+  # These are two different questions and is_linux answers only the first: an
+  # out-of-tree POSIX platform may set is_linux so that the thousands of
+  # is_linux conditions in the build gate the right things, and still have a
+  # system call surface of its own. PartitionAlloc has POSIX fallbacks for
+  # everything this gates - a pthread-based lock, and anonymous regions that
+  # simply go unnamed.
+  partition_alloc_has_linux_kernel = is_linux || is_chromeos || is_android
+}

diff --git a/services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics.cc b/services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics.cc
index 0e7ab661dd..cce88e35f4 100644
--- a/services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics.cc
+++ b/services/resource_coordinator/public/cpp/memory_instrumentation/os_metrics.cc
@@ -8,6 +8,42 @@
 
 namespace memory_instrumentation {
 
+// Every implementation of the two static methods below is per-KERNEL rather
+// than per-platform-family: os_metrics_linux.cc is /proc/<pid>/smaps and
+// prctl(PR_SET_DUMPABLE), os_metrics_win.cc is PSAPI, os_metrics_mac.cc is
+// mach_vm_region, os_metrics_fuchsia.cc is zx_object_get_info. A platform in
+// one of those families whose kernel is its own matches none of them, and
+// this is the arm it gets.
+//
+// false is what FillOSMemoryDump already means when it has nothing to report
+// - os_metrics_fuchsia.cc returns it whenever GetMemoryInfo fails - and the
+// caller in client_process_impl.cc logs "OS memory dump failed" and reports
+// the failure outcome. An implementation that filled the struct with zeroes
+// instead would put a process using no memory into about:memory.
+//
+// The condition for a real one is a way to ask this kernel what a process's
+// resident set is from OUTSIDE that process, which is what every backend
+// above does and what /proc here does not answer yet.
+#if !BUILDFLAG(IS_WIN) && !BUILDFLAG(IS_APPLE) && !BUILDFLAG(IS_FUCHSIA) && \
+    !((BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_LINUX) ||                      \
+       BUILDFLAG(IS_CHROMEOS)) &&                                           \
+      BUILDFLAG(HAS_LINUX_KERNEL))
+
+// static
+bool OSMetrics::FillOSMemoryDump(base::ProcessHandle handle,
+                                 const MemDumpFlagSet& flags,
+                                 mojom::RawOSMemDump* dump) {
+  return false;
+}
+
+// static
+std::vector<mojom::VmRegionPtr> OSMetrics::GetProcessMemoryMaps(
+    base::ProcessHandle) {
+  return std::vector<mojom::VmRegionPtr>();
+}
+
+#endif
+
 // static
 bool OSMetrics::FillProcessMemoryMaps(base::ProcessHandle handle,
                                       mojom::MemoryMapOption mmap_option,

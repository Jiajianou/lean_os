+
+# The sockaddr helpers, which need nothing from the network stack: a
+# sockaddr_storage wrapper and the function that fills in a sockaddr_un.
+# //mojo/public/cpp/platform needs exactly these to name a Unix-domain
+# socket, and until this target existed the only way to reach them was a
+# dependency on all of //net - which is a layer above mojo rather than below
+# it, and which drags in BoringSSL, ICU and SQLite behind it.
+source_set("sockaddr_util") {
+  sources = [
+    "base/sockaddr_storage.cc",
+    "base/sockaddr_storage.h",
+  ]
+
+  if (is_posix || is_fuchsia) {
+    sources += [
+      "base/sockaddr_util_posix.cc",
+      "base/sockaddr_util_posix.h",
+    ]
+  }
+
+  defines = [ "NET_IMPLEMENTATION" ]
+
+  deps = [
+    "//base",
     "//net/base:net_export_header",
   ]
 }

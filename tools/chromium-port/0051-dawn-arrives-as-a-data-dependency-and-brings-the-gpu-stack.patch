+  # installed. has_linux_kernel, for the reason the rest of this port draws
+  # the same line.
+  if (has_linux_kernel) {
     deps += [
       "//content/common",
       "//gpu/config",
       "//sandbox/policy",
     ]
   }
-  if (!is_fuchsia) {
+
+  # And use_dawn, which this target never asked. Dawn's native library
+  # DATA-deps the Vulkan loader, which data-deps SwiftShader and the
+  # validation layers - so a build with use_dawn already false still compiled
+  # 54 objects of subzero, a run-time code generator, so that they could sit
+  # beside a binary that never opens them. Nothing links any of it, which is
+  # why gn path finds no path without --with-data and why this survived three
+  # earlier milestones of removing the GPU stack.
+  #
+  # The source file already carves out one Linux platform that does not use
+  # Dawn - !(is_linux && enable_cast_receiver) - so this is that same
+  # observation asked as the flag Chromium already has for it.
+  if (!is_fuchsia && use_dawn) {
     deps += [
       "//third_party/dawn/include/dawn:cpp_headers",
       "//third_party/dawn/src/dawn:proc",
       "//third_party/dawn/src/dawn/native",
     ]
   }
+  public_deps = [ "//ui/gl:buildflags" ]
 }

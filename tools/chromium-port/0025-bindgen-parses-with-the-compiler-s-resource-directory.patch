diff --git a/build/rust/rust_bindgen_generator.gni b/build/rust/rust_bindgen_generator.gni
--- a/build/rust/rust_bindgen_generator.gni
+++ b/build/rust/rust_bindgen_generator.gni
@@ -11,6 +11,25 @@
   import("//build/toolchain/win/win_toolchain_data.gni")
 }
 
+declare_args() {
+  # The clang resource directory bindgen parses headers with.
+  #
+  # The default is the compiler this build is configured around, which is the
+  # right answer whenever that compiler is also the one compiling the target.
+  # It is not the right answer when they are different programs - an
+  # out-of-tree target can be compiled by its own clang while clang_base_path
+  # still points at Chromium's, because clang_base_path is one global that the
+  # HOST toolchain reads too. Two different clang resource directories then
+  # end up in one include path, and clang's own stdint.h ends with
+  #
+  #   #if __STDC_HOSTED__ && __has_include_next(<stdint.h>)
+  #
+  # so each of them includes the other, the include guard the first one set
+  # swallows the second, and nothing declares uint8_t. It fails in a header
+  # that is not wrong about anything.
+  bindgen_resource_dir = ""
+}
+
 _bindgen_path = "${rust_bindgen_root}/bin/bindgen"
 if (host_os == "win") {
   _bindgen_path = "${_bindgen_path}.exe"
@@ -238,9 +257,13 @@
     # says the wrong thing. We point it to our clang's resource dir which will
     # make it behave consistently with our other command line flags and allows
     # system headers to be found.
-    clang_resource_dir =
-        rebase_path(clang_base_path + "/lib/clang/" + clang_version,
-                    root_build_dir)
+    if (bindgen_resource_dir == "") {
+      clang_resource_dir =
+          rebase_path(clang_base_path + "/lib/clang/" + clang_version,
+                      root_build_dir)
+    } else {
+      clang_resource_dir = rebase_path(bindgen_resource_dir, root_build_dir)
+    }
     args += [
       "-resource-dir",
       clang_resource_dir,

@@ -59,6 +59,22 @@
   // Except if the process is the browser, if the process is running with the
   // --no-sandbox flag, this unconditionally returns true.
   static bool IsProcessSandboxed();
+
+#if BUILDFLAG(IS_LINUX) && !BUILDFLAG(HAS_LINUX_KERNEL)
+  // Put this process into the only sandbox this platform has, and answer
+  // whether it is in it. There is no seccomp-bpf and there are no namespaces
+  // here; what there is is a capability set the kernel assigned from a
+  // manifest at spawn and which can only ever shrink, so entering the sandbox
+  // means giving the whole of it up. A renderer needs none of it: the pipe it
+  // talks to the browser over is a descriptor it was handed, and this
+  // platform's Unix-domain sockets, shared memory and futexes need no
+  // capability by design.
+  //
+  // Called by the renderer itself rather than by its launcher, which is where
+  // a platform with seccomp calls the equivalent - the process that is about
+  // to run somebody else's code is the one that closes the door behind it.
+  static bool EnterCapabilitySandbox();
+#endif
 };
 
 }  // namespace policy

+// header below is there is a question about the KERNEL, and the two are
+// not the same. Every use of what it declares is already guarded on a
+// macro that comes from it, so a platform without it takes the branch it
+// was always going to take - the include was the only thing that stopped
+// the file compiling.
+#if V8_OS_LINUX && __has_include(<linux/auxvec.h>) && __has_include(<sys/auxv.h>)
 #include <linux/auxvec.h>  // AT_HWCAP
 #include <sys/auxv.h>      // getauxval()
 #endif

 #include <sys/param.h>
 #include <unistd.h>
+#if defined(__Fuchsia__) || \
+    (defined(__has_include) && !__has_include(<sys/sysctl.h>))
+#define WELS_NPROCESSORS_FROM_SYSCONF 1
+#endif
 #ifdef __EMSCRIPTEN__
 #include <emscripten/threading.h>
-#elif !defined(__Fuchsia__)
+#elif !defined(WELS_NPROCESSORS_FROM_SYSCONF)
 #include <sys/sysctl.h>
 #endif
 #ifdef __APPLE__
@@ -236,7 +240,7 @@ WELS_THREAD_ERROR_CODE    WelsThreadCreate (WELS_THREAD_HANDLE* thread,  LPWELS_
   err = pthread_attr_init (&at);
   if (err)
     return err;
-#if !defined(__ANDROID__) && !defined(__Fuchsia__)
+#if !defined(__ANDROID__) && !defined(__Fuchsia__) && defined(PTHREAD_SCOPE_SYSTEM)
   err = pthread_attr_setscope (&at, PTHREAD_SCOPE_SYSTEM);
   if (err)

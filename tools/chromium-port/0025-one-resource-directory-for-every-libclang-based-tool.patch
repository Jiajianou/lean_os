diff --git a/build/config/clang/clang.gni b/build/config/clang/clang.gni
--- a/build/config/clang/clang.gni
+++ b/build/config/clang/clang.gni
@@ -83,6 +83,26 @@
 
   clang_base_path = default_clang_base_path
 
+  # The clang resource directory that libclang-based TOOLS parse headers
+  # with - bindgen, Crubit, V8's metagen. Empty means the one belonging to
+  # clang_base_path, which is right whenever that compiler is also the one
+  # compiling the target.
+  #
+  # It is not right when they are different programs. clang_base_path is a
+  # single global that the HOST toolchain reads too, so a target compiled by
+  # its own clang - an out-of-tree platform with a toolchain of its own -
+  # leaves those tools parsing with a DIFFERENT clang's builtin headers than
+  # the ones the compiler uses. If the target's own resource directory is
+  # also on the include path, both end up in one search order, and clang's
+  # stdint.h ends with
+  #
+  #   #if __STDC_HOSTED__ && __has_include_next(<stdint.h>)
+  #
+  # so each of them includes the other, the include guard the first one set
+  # swallows the second, and nothing declares intmax_t. Every diagnostic that
+  # follows names a header that is not wrong about anything.
+  libclang_resource_dir = ""
+
   # Specifies whether or not bitcode should be embedded during compilation. This
   # is used for creating a MLGO corpus from Chromium in the non-ThinLTO case.
   clang_embed_bitcode = false
@@ -92,6 +112,17 @@
   lld_emit_indexes_and_imports = false
 }
 
+# Per toolchain, and not only because an argument in args.gn is not. The
+# question this answers is "whose builtin headers should this parse with",
+# and the answer is the compiler of the toolchain doing the parsing: a build
+# that names one here means it for the target, while the HOST tools in the
+# same build are still compiled by clang_base_path's clang and still need its
+# resource directory. A cross-compiler is usually built for one architecture,
+# so the target's copy has no arm_neon.h to offer a host tool that wants one.
+if (libclang_resource_dir == "" || !is_a_target_toolchain) {
+  libclang_resource_dir = "$clang_base_path/lib/clang/$clang_version"
+}
+
 # Siso's remote execution rules are based off the prefix
 # "../../third_party/llvm-build/Release+Asserts/bin/clang++".
 # Thus, when using a custom clang base path, we cannot use remote execution.
diff --git a/build/rust/rust_bindgen_generator.gni b/build/rust/rust_bindgen_generator.gni
--- a/build/rust/rust_bindgen_generator.gni
+++ b/build/rust/rust_bindgen_generator.gni
@@ -238,9 +238,10 @@
     # says the wrong thing. We point it to our clang's resource dir which will
     # make it behave consistently with our other command line flags and allows
     # system headers to be found.
-    clang_resource_dir =
-        rebase_path(clang_base_path + "/lib/clang/" + clang_version,
-                    root_build_dir)
+    # libclang_resource_dir, not clang_base_path's own: see the comment on
+    # that argument in //build/config/clang/clang.gni. They are the same
+    # directory unless the target has a compiler of its own.
+    clang_resource_dir = rebase_path(libclang_resource_dir, root_build_dir)
     args += [
       "-resource-dir",
       clang_resource_dir,

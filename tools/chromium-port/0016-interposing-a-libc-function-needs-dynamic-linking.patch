+  # Whether a symbol defined in an executable takes precedence over one of
+  # the same name in a library it links against.
+  #
+  # That ordering is what dlsym(RTLD_NEXT) walks and what an interposing
+  # wrapper - base/files/scoped_file_linux.cc's close(2) is one - depends on.
+  # A statically linked program has no such ordering: there is one definition
+  # of each name and the linker refuses a second rather than choosing.
+  has_symbol_interposition = true

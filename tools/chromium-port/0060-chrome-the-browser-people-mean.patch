+// kNetworkIdDisconnected, which is not: the machine is on a network, it just
+// cannot say which one.
+void GetDiscoveryNetworkInfoListImpl(
+    const struct ifaddrs* if_list,
+    std::vector<DiscoveryNetworkInfo>* network_info_list) {
+  for (; if_list != nullptr; if_list = if_list->ifa_next) {
+    if ((if_list->ifa_flags & IFF_RUNNING) == 0 ||
+        (if_list->ifa_flags & IFF_UP) == 0 ||
+        (if_list->ifa_flags & IFF_LOOPBACK) != 0) {
+      continue;
+    }
+    if (if_list->ifa_addr == nullptr ||
+        if_list->ifa_addr->sa_family != AF_INET) {
+      continue;
+    }
+    std::string name(if_list->ifa_name);
+    if (name.empty() ||
+        std::ranges::any_of(*network_info_list,
+                            [&name](const DiscoveryNetworkInfo& info) {
+                              return info.name == name;
+                            })) {
+      continue;
+    }
+    network_info_list->push_back({name, std::string()});
+  }
+}

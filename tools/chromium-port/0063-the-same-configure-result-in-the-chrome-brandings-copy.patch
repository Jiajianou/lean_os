Patch 0042's two lines, in the copy of ffmpeg's configure result that the
Chrome branding reads.

third_party/ffmpeg carries one config.h per branding and platform, each
"Automatically generated by configure" on somebody else's machine. 0042 made
HAVE_GETAUXVAL a question for the compiler doing this build in the Chromium
branding's copy, which is the one the browser builds. Electron's own args
say ffmpeg_branding = "Chrome" (proprietary codecs), so it reads
config/Chrome/linux/x64/config.h - where getauxval is still a remembered
link test, and libavutil/cpu.c stops on <sys/auxv.h>.

The Chrome branding also compiles libavformat/img2.c, the image tag table it
lists beside the AAC demuxer, and img2.h includes <glob.h> under HAVE_GLOB.
Nothing in img2.c calls glob(); img2dec.c does, and it is not built. So the
whole cost of the wrong answer is again one header, and the answer is again
__has_include, which names no C library and gives 1 wherever the configure
test passed.
diff --git a/third_party/ffmpeg/chromium/config/Chrome/linux/x64/config.h b/third_party/ffmpeg/chromium/config/Chrome/linux/x64/config.h
index ce39647e64..51b2d17d21 100644
--- a/third_party/ffmpeg/chromium/config/Chrome/linux/x64/config.h
+++ b/third_party/ffmpeg/chromium/config/Chrome/linux/x64/config.h
@@ -328,7 +328,19 @@
 #define HAVE_ELF_AUX_INFO 0
 #define HAVE_FCNTL 1
 #define HAVE_GETADDRINFO 0
-#define HAVE_GETAUXVAL 1
+/* The same two lines as patch 0042 makes in the Chromium-branded copy of
+   this file, which is a configure result from another machine: see there.
+   Electron builds the Chrome branding (ffmpeg_branding = "Chrome"), so it
+   reads this copy and that patch never reached it. */
+#if defined(__has_include)
+#  if __has_include(<sys/auxv.h>)
+#    define HAVE_GETAUXVAL 1
+#  else
+#    define HAVE_GETAUXVAL 0
+#  endif
+#else
+#  define HAVE_GETAUXVAL 1
+#endif
 #define HAVE_GETENV 1
 #define HAVE_GETHRTIME 0
 #define HAVE_GETOPT 1
@@ -340,7 +352,19 @@
 #define HAVE_GETSTDHANDLE 0
 #define HAVE_GETSYSTEMTIMEASFILETIME 0
 #define HAVE_GETTIMEOFDAY 1
-#define HAVE_GLOB 1
+/* glob(3), the same kind of answer. What it gates in the sources this
+   branding compiles is the #include of <glob.h> in libavformat/img2.h, which
+   img2.c - the image tag table the AAC demuxer is listed with - includes and
+   never calls into; the glob() call is in img2dec.c, which is not built. */
+#if defined(__has_include)
+#  if __has_include(<glob.h>)
+#    define HAVE_GLOB 1
+#  else
+#    define HAVE_GLOB 0
+#  endif
+#else
+#  define HAVE_GLOB 1
+#endif
 #define HAVE_GLXGETPROCADDRESS 0
 #define HAVE_GMTIME_R 1
 #define HAVE_INET_ATON 0

diff --git a/build/config/rust.gni b/build/config/rust.gni
index 3b5db82dd1..153c75e559 100644
--- a/build/config/rust.gni
+++ b/build/config/rust.gni
@@ -198,8 +198,34 @@ if (enable_rust) {
 # targets to Rust targets comprehensively despite not having official support
 # (see '*_toolchain_supports_platform above') to enable experimentation with
 # other toolchains.
+declare_args() {
+  # The Rust target triple to build for, when it is not one this file knows
+  # how to derive from the GN platform. An out-of-tree platform that poses as
+  # another for GN's sake - so that the thousands of is_linux conditions gate
+  # the right things - still has a Rust target of its own, and the triple is
+  # what decides which std and which libc a crate is compiled against.
+  #
+  # Such a triple is described by a target specification file that rustc finds
+  # through RUST_TARGET_PATH, which is why setting this also passes
+  # -Zunstable-options: rustc will not load a target it did not ship with
+  # otherwise. Setting this takes responsibility for the triple being one
+  # rustc accepts, so the known-triples assert below is skipped.
+  rust_abi_target_override = ""
+}
+
 rust_abi_target = ""
-if (is_linux || is_chromeos) {
+
+# Whether rust_abi_target came from the override above. The override names the
+# triple of the target platform, so it applies in the toolchains that build
+# FOR that platform and not in the ones that build host tools - a proc macro
+# and a build script are native binaries, and their triple is the host's.
+rust_abi_target_is_from_override =
+    rust_abi_target_override != "" && !toolchain_for_rust_host_build_tools &&
+    current_os == target_os && current_cpu == target_cpu
+
+if (rust_abi_target_is_from_override) {
+  rust_abi_target = rust_abi_target_override
+} else if (is_linux || is_chromeos) {
   if (current_cpu == "arm64") {
     rust_abi_target = "aarch64-unknown-linux-gnu"
   } else if (current_cpu == "x86") {
@@ -343,7 +369,7 @@ if (is_linux || is_chromeos) {
   }
 }
 
-if (toolchain_has_rust) {
+if (toolchain_has_rust && !rust_abi_target_is_from_override) {
   assert(rust_abi_target != "")
 
   _known_rust_target_triples_filepath = "//build/rust/known-target-triples.txt"

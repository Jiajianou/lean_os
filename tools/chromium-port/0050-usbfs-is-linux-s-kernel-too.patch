+  # rest of this port now draws with has_linux_kernel. use_udev is already
+  # false in this build, so UsbServiceLinux is not compiled either and
+  # UsbService::Create has no backend to return - which is the truth about a
+  # machine whose USB is xHCI and HID inside its own kernel.
+  if (has_linux_kernel) {
     sources += [
       "usb_device_linux.cc",
       "usb_device_linux.h",
@@ -131,14 +138,14 @@ static_library("usb") {

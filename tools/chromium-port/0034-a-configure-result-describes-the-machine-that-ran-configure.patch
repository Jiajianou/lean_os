diff --git a/third_party/fontconfig/include/meson-config.h b/third_party/fontconfig/include/meson-config.h
index 5a15f31a46..0f683c15e1 100644
--- a/third_party/fontconfig/include/meson-config.h
+++ b/third_party/fontconfig/include/meson-config.h
@@ -48,7 +48,19 @@
 
 #define HAVE_FCNTL_H 1
 
-#define HAVE_FSTATFS 1
+/* Every HAVE_ in this file is a compile or a link test, and all of them were
+   run on the machine that generated it rather than on the machine being
+   built for. Three of them do not survive that distinction.
+
+   fcstat.c does not ask whether fstatfs EXISTS - it asks whether it can read
+   a filesystem type out of the answer, and it knows two ways: f_fstypename
+   on the BSDs and f_type's magic numbers on Linux. On a platform with
+   neither, its own #error fires. So the useful value of this test is what
+   fontconfig can do with the call. */
+#if defined(__linux__) || defined(__EMSCRIPTEN__) || \
+    defined(HAVE_STRUCT_STATFS_F_FSTYPENAME)
+#  define HAVE_FSTATFS 1
+#endif
 
 #define HAVE_FSTATVFS 1
 
@@ -72,7 +84,13 @@
 
 #define HAVE_GETTEXT 1
 
-#define HAVE_GNU_STRERROR_R 1
+/* The GNU flavour of strerror_r returns char * and the POSIX one returns
+   int, and a caller that picks wrong assigns an int to a pointer. Which one
+   a platform has is not a property of having strerror_r at all - it is a
+   property of glibc. */
+#if defined(__GLIBC__)
+#  define HAVE_GNU_STRERROR_R 1
+#endif
 
 #define HAVE_INTEL_ATOMIC_PRIMITIVES 1
 
@@ -98,7 +116,12 @@
 
 #define HAVE_RANDOM 1
 
-#define HAVE_RANDOM_R 1
+/* random_r and initstate_r are glibc's reentrant extension, and struct
+   random_data is declared nowhere else. fontconfig falls back to random(3)
+   and then to lrand48(3) and then to rand(3) on its own. */
+#if defined(__GLIBC__)
+#  define HAVE_RANDOM_R 1
+#endif
 
 #define HAVE_RAND_R 1
 

# What the Rust libc module claims about this libc's ABI, named once and
# answered twice: by x86_64-lean_os-gcc reading the C headers, and by rustc
# reading tools/rust-port/libc/lean_os/mod.rs. tools/rust-port/gen-abi-facts.py
# turns this into tests/rust/abi_facts.c and the Rust table beside it, and
# /bin/ruststd compares the two ON THE MACHINE - which is the only place the
# two answers ever meet.
#
# Lines are:
#   struct <C spelling> | <rust path> | <field> <field> ...
#   scalar <C spelling> | <rust path>
#   const  <name> | <rust integer type>
# A field written a=b is spelled a in C and b in Rust.

struct struct stat | stat | st_mode st_size st_mtim st_atim st_ctim st_nlink st_ino st_dev st_rdev st_uid st_gid st_blksize st_blocks

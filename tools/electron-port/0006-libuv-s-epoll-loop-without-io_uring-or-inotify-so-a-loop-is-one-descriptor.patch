+/* An epoll(7) backend for a system that has epoll and not the rest of
+ * Linux's kernel interfaces: linux.c's loop without io_uring (which batches
+ * its epoll_ctl calls and runs its file operations) or inotify. epoll_wait
+ * stands in for epoll_pwait the way posix-poll.c's poll stands in for ppoll -
+ * SIGPROF is blocked around the call rather than atomically with it.
+ *
+ * Its reason to exist beside posix-poll.c is uv_backend_fd(): a loop whose
+ * readiness is one descriptor can be embedded in another loop, which is how
+ * Electron runs Node inside Chromium's message pump. poll(2) has no such
+ * descriptor and uv_backend_fd() answers -1 there.
+ */
+
+#include "uv.h"
+#include "internal.h"
+
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/epoll.h>
+#include <unistd.h>
+
+/* The events of the epoll_wait being dispatched, so a callback that stops
+ * watching a descriptor can blank its later entries in the same batch -
+ * linux.c keeps this in the loop's internal fields, which exist there only
+ * under __linux__. A loop is run by one thread at a time, and the batch is
+ * that thread's while it is being dispatched - saved and put back around
+ * it, because a callback may run another loop on the same thread.
+ */
+struct uv__epoll_batch {
+  uv_loop_t* loop;
+  struct epoll_event* events;
+  int nfds;
+};
+
+static _Thread_local struct uv__epoll_batch* uv__epoll_dispatching;
+
+
+int uv__platform_loop_init(uv_loop_t* loop) {
+  loop->backend_fd = epoll_create1(O_CLOEXEC);
+  if (loop->backend_fd == -1)
+    return UV__ERR(errno);
+  return 0;
+}
+
+
+void uv__platform_loop_delete(uv_loop_t* loop) {
+  if (loop->backend_fd != -1) {
+    uv__close(loop->backend_fd);
+    loop->backend_fd = -1;
+  }
+}
+
+
+int uv__io_fork(uv_loop_t* loop) {
+  uv__platform_loop_delete(loop);
+  return uv__platform_loop_init(loop);
+}
+
+
+void uv__platform_invalidate_fd(uv_loop_t* loop, int fd) {
+  struct uv__epoll_batch* batch;
+  struct epoll_event dummy;
+  int i;
+
+  assert(fd >= 0);
+
+  batch = uv__epoll_dispatching;
+  if (batch != NULL && batch->loop == loop)
+    for (i = 0; i < batch->nfds; i++)
+      if (batch->events[i].data.fd == fd)
+        batch->events[i].data.fd = -1;
+
+  memset(&dummy, 0, sizeof(dummy));
+  epoll_ctl(loop->backend_fd, EPOLL_CTL_DEL, fd, &dummy);
+}
+
+
+int uv__io_check_fd(uv_loop_t* loop, int fd) {
+  struct epoll_event e;
+  int rc;
+
+  memset(&e, 0, sizeof(e));
+  e.events = POLLIN;
+  e.data.fd = -1;
+
+  rc = 0;
+  if (epoll_ctl(loop->backend_fd, EPOLL_CTL_ADD, fd, &e))
+    if (errno != EEXIST)
+      rc = UV__ERR(errno);
+
+  if (rc == 0)
+    if (epoll_ctl(loop->backend_fd, EPOLL_CTL_DEL, fd, &e))
+      abort();
+
+  return rc;
+}
+
+
+void uv__io_poll(uv_loop_t* loop, int timeout) {
+  uv__loop_internal_fields_t* lfields;
+  struct uv__epoll_batch batch;
+  struct uv__epoll_batch* outer_batch;
+  struct epoll_event events[1024];
+  struct epoll_event* pe;
+  struct epoll_event e;
+  struct uv__queue* q;
+  uv__io_t* w;
+  sigset_t* sigmask;
+  sigset_t sigset;
+  uint64_t base;
+  int real_timeout;
+  int have_signals;
+  int nevents;
+  int epollfd;
+  int count;
+  int nfds;
+  int fd;
+  int op;
+  int i;
+  int user_timeout;
+  int reset_timeout;
+
+  lfields = uv__get_internal_fields(loop);
+
+  sigmask = NULL;
+  if (loop->flags & UV_LOOP_BLOCK_SIGPROF) {
+    sigemptyset(&sigset);
+    sigaddset(&sigset, SIGPROF);
+    sigmask = &sigset;
+  }
+
+  assert(timeout >= -1);
+  base = loop->time;
+  count = 48;
+  real_timeout = timeout;
+
+  if (lfields->flags & UV_METRICS_IDLE_TIME) {
+    reset_timeout = 1;
+    user_timeout = timeout;
+    timeout = 0;
+  } else {
+    reset_timeout = 0;
+    user_timeout = 0;
+  }
+
+  epollfd = loop->backend_fd;
+
+  memset(&e, 0, sizeof(e));
+
+  while (!uv__queue_empty(&loop->watcher_queue)) {
+    q = uv__queue_head(&loop->watcher_queue);
+    w = uv__queue_data(q, uv__io_t, watcher_queue);
+    uv__queue_remove(q);
+    uv__queue_init(q);
+
+    op = EPOLL_CTL_MOD;
+    if (w->events == 0)
+      op = EPOLL_CTL_ADD;
+
+    w->events = w->pevents;
+    e.events = w->pevents;
+    e.data.fd = w->fd;
+    fd = w->fd;
+
+    if (!epoll_ctl(epollfd, op, fd, &e))
+      continue;
+
+    assert(op == EPOLL_CTL_ADD);
+    assert(errno == EEXIST);
+
+    /* File descriptor that's been watched before, update event mask. */
+    if (epoll_ctl(epollfd, EPOLL_CTL_MOD, fd, &e))
+      abort();
+  }
+
+  batch.loop = loop;
+  batch.events = events;
+  batch.nfds = 0;
+
+  for (;;) {
+    if (loop->nfds == 0)
+      break;
+
+    uv__io_poll_prepare(loop, sigmask, timeout);
+    nfds = epoll_wait(epollfd, events, ARRAY_SIZE(events), timeout);
+    uv__io_poll_check(loop, sigmask);
+
+    if (nfds == -1)
+      assert(errno == EINTR);
+    else if (nfds == 0)
+      /* Unlimited timeout should only return with events or signal. */
+      assert(timeout != -1);
+
+    if (nfds == 0 || nfds == -1) {
+      if (reset_timeout != 0) {
+        timeout = user_timeout;
+        reset_timeout = 0;
+      } else if (nfds == 0) {
+        return;
+      }
+
+      /* Interrupted by a signal. Update timeout and poll again. */
+      goto update_timeout;
+    }
+
+    have_signals = 0;
+    nevents = 0;
+
+    batch.nfds = nfds;
+    outer_batch = uv__epoll_dispatching;
+    uv__epoll_dispatching = &batch;
+
+    for (i = 0; i < nfds; i++) {
+      pe = events + i;
+      fd = pe->data.fd;
+
+      /* Skip invalidated events, see uv__platform_invalidate_fd */
+      if (fd == -1)
+        continue;
+
+      assert(fd >= 0);
+      assert((unsigned) fd < loop->nwatchers);
+
+      w = loop->watchers[fd];
+
+      if (w == NULL) {
+        /* File descriptor that we've stopped watching, disarm it. */
+        epoll_ctl(epollfd, EPOLL_CTL_DEL, fd, pe);
+        continue;
+      }
+
+      /* Give users only events they're interested in. */
+      pe->events &= w->pevents | POLLERR | POLLHUP;
+
+      /* An error or a hangup alone still has to move the watcher forward:
+       * merge in what it is waiting for and let uv__read() and uv__write()
+       * find out. linux.c explains the epoll quirk this answers. */
+      if (pe->events == POLLERR || pe->events == POLLHUP)
+        pe->events |=
+          w->pevents & (POLLIN | POLLOUT | UV__POLLRDHUP | UV__POLLPRI);
+
+      if (pe->events != 0) {
+        /* Run signal watchers last. */
+        if (w == &loop->signal_io_watcher) {
+          have_signals = 1;
+        } else {
+          uv__metrics_update_idle_time(loop);
+          uv__io_cb(loop, w, pe->events);
+        }
+
+        nevents++;
+      }
+    }
+
+    uv__metrics_inc_events(loop, nevents);
+    if (reset_timeout != 0) {
+      timeout = user_timeout;
+      reset_timeout = 0;
+      uv__metrics_inc_events_waiting(loop, nevents);
+    }
+
+    if (have_signals != 0) {
+      uv__metrics_update_idle_time(loop);
+      uv__signal_event(loop, &loop->signal_io_watcher, POLLIN);
+    }
+
+    uv__epoll_dispatching = outer_batch;
+
+    if (have_signals != 0)
+      break;  /* Event loop should cycle now so don't poll again. */
+
+    if (nevents != 0) {
+      if (nfds == ARRAY_SIZE(events) && --count != 0) {
+        /* Poll for more events but don't block this time. */
+        timeout = 0;
+        continue;
+      }
+      break;
+    }
+
+update_timeout:
+    if (timeout == 0)
+      break;
+
+    if (timeout == -1)
+      continue;
+
+    assert(timeout > 0);
+
+    real_timeout -= (loop->time - base);
+    if (real_timeout <= 0)
+      break;
+
+    timeout = real_timeout;
+  }
+}

+
+/* The questions an OS file answers, for a POSIX system whose only way to
+ * answer them is the one every POSIX system has: sysconf(3) for memory, and
+ * /proc in Linux's formats where it exists. A file that is not there is an
+ * answer of its own - no load average is zeros, as the Hurd's is - rather
+ * than a number made up to fill the field.
+ */
+
+#include "uv.h"
+#include "internal.h"
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+static uint64_t uv__sysconf_bytes(int name) {
+  long pages;
+  long page_size;
+
+  pages = sysconf(name);
+  page_size = sysconf(_SC_PAGESIZE);
+  if (pages <= 0 || page_size <= 0)
+    return 0;
+
+  return (uint64_t) pages * (uint64_t) page_size;
+}
+
+
+int uv_resident_set_memory(size_t* rss) {
+  char buf[128];
+  unsigned long size;
+  unsigned long resident;
+  long page_size;
+  int err;
+
+  err = uv__slurp("/proc/self/statm", buf, sizeof(buf));
+  if (err)
+    return err;
+
+  if (2 != sscanf(buf, "%lu %lu", &size, &resident))
+    return UV_EINVAL;
+
+  page_size = sysconf(_SC_PAGESIZE);
+  if (page_size <= 0)
+    return UV_EINVAL;
+
+  *rss = (size_t) resident * (size_t) page_size;
+  return 0;
+}
+
+
+uint64_t uv_get_free_memory(void) {
+  return uv__sysconf_bytes(_SC_AVPHYS_PAGES);
+}
+
+
+uint64_t uv_get_total_memory(void) {
+  return uv__sysconf_bytes(_SC_PHYS_PAGES);
+}
+
+
+uint64_t uv_get_constrained_memory(void) {
+  return uv__get_rlimit_max_memory();
+}
+
+
+uint64_t uv_get_available_memory(void) {
+  return uv_get_free_memory();
+}
+
+
+int uv_uptime(double* uptime) {
+  char buf[128];
+  struct timespec now;
+
+  if (0 == uv__slurp("/proc/uptime", buf, sizeof(buf)))
+    if (1 == sscanf(buf, "%lf", uptime))
+      return 0;
+
+#ifdef CLOCK_BOOTTIME
+  if (0 == clock_gettime(CLOCK_BOOTTIME, &now)) {
+    *uptime = now.tv_sec + now.tv_nsec / 1e9;
+    return 0;
+  }
+#endif
+  if (0 == clock_gettime(CLOCK_MONOTONIC, &now)) {
+    *uptime = now.tv_sec + now.tv_nsec / 1e9;
+    return 0;
+  }
+
+  return UV__ERR(errno);
+}
+
+
+void uv_loadavg(double avg[3]) {
+  char buf[128];
+
+  avg[0] = avg[1] = avg[2] = 0;
+  if (0 == uv__slurp("/proc/loadavg", buf, sizeof(buf)))
+    if (3 != sscanf(buf, "%lf %lf %lf", &avg[0], &avg[1], &avg[2]))
+      avg[0] = avg[1] = avg[2] = 0;
+}
+
+
+static void uv__cpuinfo_model(char* model, size_t size, int* speed) {
+  FILE* fp;
+  char line[256];
+  char* value;
+  double mhz;
+
+  model[0] = '\0';
+  *speed = 0;
+  fp = uv__open_file("/proc/cpuinfo");
+  if (fp == NULL)
+    return;
+
+  while (fgets(line, sizeof(line), fp) != NULL) {
+    value = strchr(line, ':');
+    if (value == NULL)
+      continue;
+    value++;
+    while (*value == ' ' || *value == '\t')
+      value++;
+    value[strcspn(value, "\n")] = '\0';
+
+    if (model[0] == '\0' && 0 == strncmp(line, "model name", 10))
+      uv__strscpy(model, value, size);
+    else if (*speed == 0 && 0 == strncmp(line, "cpu MHz", 7))
+      if (1 == sscanf(value, "%lf", &mhz))
+        *speed = (int) mhz;
+
+    if (model[0] != '\0' && *speed != 0)
+      break;
+  }
+
+  fclose(fp);
+}
+
+
+int uv_cpu_info(uv_cpu_info_t** cpu_infos, int* count) {
+  char model[128];
+  uv_cpu_info_t* infos;
+  long online;
+  int speed;
+  int i;
+
+  *cpu_infos = NULL;
+  *count = 0;
+
+  online = sysconf(_SC_NPROCESSORS_ONLN);
+  if (online <= 0)
+    return UV_ENOSYS;
+
+  infos = uv__calloc(online, sizeof(*infos));
+  if (infos == NULL)
+    return UV_ENOMEM;
+
+  uv__cpuinfo_model(model, sizeof(model), &speed);
+  if (model[0] == '\0')
+    uv__strscpy(model, "unknown", sizeof(model));
+
+  for (i = 0; i < online; i++) {
+    infos[i].model = uv__strdup(model);
+    if (infos[i].model == NULL) {
+      uv_free_cpu_info(infos, i);
+      return UV_ENOMEM;
+    }
+    infos[i].speed = speed;
+  }
+
+  *cpu_infos = infos;
+  *count = (int) online;
+  return 0;
+}
+
+
+/* proctitle.c keeps the title in argv's memory and hands it here so the
+ * system can show it too. Linux does that with prctl(PR_SET_NAME), which
+ * names the calling thread and keeps the first fifteen characters; the POSIX
+ * spelling of the same thing is pthread_setname_np, and the same fifteen
+ * keep it inside every system's limit.
+ */
+void uv__set_process_title(const char* title) {
+  char name[16];
+
+  uv__strscpy(name, title, sizeof(name));
+  pthread_setname_np(pthread_self(), name);
+}

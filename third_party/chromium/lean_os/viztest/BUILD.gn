# A program that links the DISPLAY compositor and that this machine runs.
#
# M161 measured //components/viz/service and set it aside, on the grounds
# that it is the GPU service - //gpu/ipc/service and
# //gpu/command_buffer/service - and so wants the GL implementation compiled.
# That is true and it is not a reason, because Blink already reaches all of
# it: measured under M161's own flags, viz/service's graph is 6,555 targets
# and 6,533 of them are inside blink's 8,504. The rung is 22 targets wide and
# nine of those are //sandbox.
#
# The same thing M159 wrote down about ANGLE applies here and is why this is
# safe: the GL implementation being COMPILED is not the GL implementation
# being in a binary. This program takes the software path - a
# SoftwareOutputSurface over a SoftwareOutputDevice, which viz picks when
# there is no SkiaOutputSurface - so the linker takes nothing out of the
# GL archives, and tools/chromium-test.sh grades that on the binary rather
# than on args.gn.
executable("viztest") {
  sources = [ "chromium_viz_test.cc" ]
  deps = [
    "//base",
    "//components/viz/common",
    "//components/viz/service",

    # The scheduler, the sync point manager and the shared image manager,
    # which DisplayResourceProviderSoftware takes even on the software path.
    # NOT :gles2 - that group is the command decoder, and pulling it in
    # would put ANGLE's GL implementation in this binary and make the
    # absence checks in tools/chromium-test.sh pass for the wrong reason.
    "//gpu/command_buffer/service",
    "//skia",
    "//ui/gfx/geometry",
  ]
}

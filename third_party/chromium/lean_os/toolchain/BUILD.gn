import("//build/toolchain/gcc_toolchain.gni")

declare_args() {
  lean_os_cc = ""
  lean_os_cxx = ""
  lean_os_ar = ""
  lean_os_nm = ""
  lean_os_readelf = ""
  lean_os_target = ""
}

# Static, and not position independent.
#
# Chromium's //build/config/gcc:executable_config puts -pie on every
# executable, which needs something at load time to relocate the image and an
# interpreter named in the file to do it. This OS has a dynamic loader
# (user_space/loader, M95) and it is not the one that path names, and nothing
# on this machine is built -pie - every program here, including the twenty
# megabytes of NetSurf, is a static executable the kernel maps where it says
# it goes. -no-pie comes after the -pie that config adds, and wins.
lean_os_link_flags = [
  "-no-pie",
  "-static",
]

gcc_toolchain("x64") {
  cc = lean_os_cc
  cxx = lean_os_cxx
  ar = lean_os_ar
  nm = lean_os_nm
  ld = cxx
  extra_cflags = lean_os_target
  extra_cppflags = lean_os_target
  extra_ldflags = lean_os_target + " " +
                  string_join(" ", lean_os_link_flags)
  readelf = lean_os_readelf

  # These are INERT and are kept only because gcc_toolchain asserts that
  # current_cpu and current_os are among them. GN's rule is that "the
  # toolchain_args will be ignored when the toolchain being defined is the
  # default", and custom_toolchain makes this one the default - so every line
  # here has always been decoration. M154 found that out the slow way, looking
  # for why --sysroot never reached a command line: everything this block
  # appears to set is in fact set by args.gn, which is why nothing ever broke,
  # and `sysroot` is the one that was not, which is why gn commands that load
  # the whole tree still report /usr/include as this build's system headers.
  #
  # Where a flag has to reach every target, put it in
  # default_toolchain_cflags - a config, which bindgen can read - rather than
  # here or in extra_cflags. See //build/config/BUILD.gn.
  toolchain_args = {
    current_cpu = "x64"
    current_os = "linux"
  }
}

# This project's own targets inside Chromium's build. Nothing under
# third_party/chromium/lean_os is Chromium's, and nothing here is patched
# into Chromium: tools/build-chromium.sh symlinks this directory in as
# //lean_os, so these targets name //base the way any other consumer of
# //base would, from outside it.

group("lean_os") {
  testonly = false
  deps = [
    "//lean_os/basetest",
    "//lean_os/blinktest",
    "//lean_os/ccpainttest",
    "//lean_os/cctest",
    "//lean_os/gpuinfotest",
    "//lean_os/mojotest",
    "//lean_os/nettest",
    "//lean_os/skiatest",
    "//lean_os/v8test",
    "//lean_os/viztest",
  ]
}
